{
    "type": "esp32s3-weact-dog",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-weact-dog",
            "sdkconfig_append": [
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24",
                "CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32",
                "CONFIG_ESP_WIFI_RX_BA_WIN=8",
                "CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32",
                "CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520",
                "CONFIG_LWIP_TCP_WND_DEFAULT=11520",
                "CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"chao ni\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Chào Nhi\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_SR_MN_CN_NONE=n",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y"
            ]
        }
    ]
}
