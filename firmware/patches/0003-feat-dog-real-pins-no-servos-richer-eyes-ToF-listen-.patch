+    }
+
+    if (fx_ & kFxZzz) {
+        // Three Z's of growing size drifting up-right.
+        for (int i = 0; i < 3; ++i) {
+            float p = saw(t, 3000, i * 1000);
+            int scale = 1 + (int)(p * 3.0f);
+            int zx = rx + rw - 10 + (int)(p * 40.0f);
+            int zy = eyes_top - 10 - (int)(p * 50.0f);
+            if (zy < 0) continue;
