-                Leg& l = legs_[i];
-                if (l.moving) {
-                    float d = l.target - l.current;
-                    if (std::fabs(d) <= step) {
-                        l.current = l.target;
-                        l.moving = false;
-                        l.settled_ms = now;
-                    } else {
-                        l.current += d > 0 ? step : -step;
-                    }
-                    WriteAngle(i, l.current);
-                }
-                if (l.moving || std::fabs(l.target - l.current) >= 0.5f) all_settled = false;
-            }
