-                    if (++frame_index_ >= frame_count_) {
-                        frames_ = nullptr;
-                        busy_ = false;
-                    }
-                }
-            }
-
-            // 5) cut PWM on legs holding a pose for too long
-            for (int i = 0; i < LEG_COUNT; ++i) {
-                Leg& l = legs_[i];
-                if (l.attached && !l.moving && std::fabs(l.target - l.current) < 0.5f &&
