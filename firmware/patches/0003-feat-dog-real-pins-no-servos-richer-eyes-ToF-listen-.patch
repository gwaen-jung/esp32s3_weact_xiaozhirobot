+        }
+    }
+
+    if (fx_ & kFxQuestion) {
+        int qy = std::max(0, eyes_top - 60) + (int)(tri(t, 900) * 8.0f);
+        canvas_.drawText(rx + rw + 6, qy, "?", FX_COLOR_SYMBOL, 3);
+    }
+
+    if (fx_ & kFxExclaim) {
